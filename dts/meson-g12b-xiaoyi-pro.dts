/dts-v1/;

#include "meson-g12b-s922x.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>

/ {
    model = "CAINIAO XiaoYi Pro";
    compatible = "cainiao,xiaoyi-pro", "amlogic,s922x";

    chosen {
        bootargs = "root=LABEL=COREELEC rw console=ttyAML0,115200n8 console=tty0 no_console_suspend";
    };

    memory@0 {
        device_type = "memory";
        reg = <0x0 0x0 0x0 0xee6b2800>;
    };

    dc_in: regulator-dc-in {
        compatible = "regulator-fixed";
        regulator-name = "dc_in";
        regulator-always-on;
        regulator-boot-on;
    };

    vsys_3v3: regulator-vsys-3v3 {
        compatible = "regulator-fixed";
        regulator-name = "vsys_3v3";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        vin-supply = <&dc_in>;
    };

    vddao_1v8: regulator-vddao-1v8 {
        compatible = "regulator-fixed";
        regulator-name = "vddao_1v8";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        vin-supply = <&dc_in>;
    };

    host_vbus: regulator-host-vbus {
        compatible = "regulator-fixed";
        regulator-name = "host_vbus";
        regulator-always-on;
        regulator-boot-on;
        gpio = <&gpio GPIOH_5 GPIO_ACTIVE_HIGH>;
        enable-active-high;
    };

    vdd_amp: regulator-vdd-amp {
        compatible = "regulator-fixed";
        regulator-name = "vdd_amp";
        regulator-always-on;
        regulator-boot-on;
    };

    gpio_fan: gpio-fan {
        compatible = "gpio-fan";
        gpios = <&gpio_ao GPIOAO_11 GPIO_ACTIVE_HIGH>;
        gpio-fan,speed-map = <0 0 3000 1>;
        #cooling-cells = <2>;
    };

    adc_keys: adc-keys {
        compatible = "adc-keys";
        io-channels = <&saradc 2>;
        io-channel-names = "buttons";
        keyup-threshold-microvolt = <1700000>;
        poll-interval = <100>;

        button-recovery {
            label = "Recovery";
            linux,code = <KEY_RESTART>;
            press-threshold-microvolt = <10000>;
        };
    };

    speaker_amplifier: speaker-amplifier {
        compatible = "simple-audio-amplifier";
        sound-name-prefix = "Speaker Amplifier";
        VCC-supply = <&vdd_amp>;
        enable-gpios = <&gpio GPIOH_5 GPIO_ACTIVE_HIGH>;
    };

    wifi32k: wifi32k {
        compatible = "pwm-clock";
        #clock-cells = <0>;
        clock-frequency = <32768>;
        pwms = <&pwm_ef 0 30518 0>;
    };

    sdio_pwrseq: sdio-pwrseq {
        compatible = "mmc-pwrseq-simple";
        clocks = <&wifi32k>;
        clock-names = "ext_clock";
        reset-gpios = <&gpio GPIOX_7 GPIO_ACTIVE_LOW>;
    };
};

&sd_emmc_c {
    status = "okay";
    bus-width = <8>;
    non-removable;
    cap-mmc-highspeed;
    mmc-ddr-1_8v;
    mmc-hs200-1_8v;
    max-frequency = <200000000>;
    vmmc-supply = <&vsys_3v3>;
    vqmmc-supply = <&vddao_1v8>;
};

&sd_emmc_a {
    status = "okay";
    bus-width = <4>;
    cap-sd-highspeed;
    sd-uhs-ddr50;
    max-frequency = <200000000>;
    non-removable;
    keep-power-in-suspend;
    vmmc-supply = <&vsys_3v3>;
    vqmmc-supply = <&vddao_1v8>;
    mmc-pwrseq = <&sdio_pwrseq>;
};

&uart_AO {
    status = "okay";
};

&usb {
    status = "okay";
    dr_mode = "host";
};

&usb2_phy0 {
    status = "okay";
    phy-supply = <&vsys_3v3>;
};

&usb2_phy1 {
    status = "okay";
    phy-supply = <&host_vbus>;
};

ðmac {
    status = "okay";
    phy-mode = "rgmii";
};

&hdmi_tx {
    status = "okay";
};

&vpu {
    status = "okay";
};

&fb {
    status = "okay";
};

&cec_AO {
    status = "okay";
};

&ir {
    status = "okay";
};

&pwm_ab {
    status = "okay";
};

&pwm_ef {
    status = "okay";
};

&pwm_AO_cd {
    status = "okay";
};

&saradc {
    status = "okay";
    vref-supply = <&vddao_1v8>;
};

&watchdog {
    status = "okay";
};

&vrtc {
    status = "okay";
};

/* 删除 cpu_thermal 中已有的 cooling-maps，然后重新定义 */
&cpu_thermal {
    /delete-property/ cooling-maps;
    
    polling-delay = <1000>;
    polling-delay-passive = <100>;

    trips {
        cpu_passive: cpu-passive {
            temperature = <85000>;
            hysteresis = <2000>;
            type = "passive";
        };
    };

    cooling-maps {
        map {
            trip = <&cpu_passive>;
            cooling-device = <&gpio_fan 1 1>;
        };
    };
};

&i2c1 {
    status = "okay";
    led-controller@45 {
        compatible = "awinic,aw2013";
        reg = <0x45>;
        #address-cells = <1>;
        #size-cells = <0>;

        led@0 {
            reg = <0>;
            led-max-microamp = <5000>;
        };

        led@1 {
            reg = <1>;
            led-max-microamp = <5000>;
        };

        led@2 {
            reg = <2>;
            led-max-microamp = <5000>;
        };
    };
};

&i2c2 {
    status = "okay";
    rtc@68 {
        compatible = "dallas,ds1307";
        reg = <0x68>;
    };
};
