/dts-v1/;

#include "meson-g12b-a311d.dtsi"

/ {
	model = "CAINIAO XiaoYi Pro";
	compatible = "cainiao,xiaoyi-pro", "amlogic,a311d";

	chosen {
		bootargs = "root=LABEL=COREELEC rw console=ttyAML0,115200n8 console=tty0 no_console_suspend";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0xee6b2800>;
	};

	aliases {
		serial0 = &uart_AO;
		mmc0 = &sd_emmc_c;
		mmc1 = &sd_emmc_b;
		mmc2 = &sd_emmc_a;
	};

	dc_in: regulator-dc-in {
		compatible = "regulator-fixed";
		regulator-name = "dc_in";
		regulator-always-on;
		regulator-boot-on;
	};

	vsys_3v3: regulator-vsys-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vsys_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&dc_in>;
	};

	vddao_1v8: regulator-vddao-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vddao_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&dc_in>;
	};

	vddcpu_a: regulator-vddcpu-a {
		compatible = "pwm-regulator";
		pwms = <&pwm_ab 0 1250 0>;
		regulator-name = "VDDCPU_A";
		regulator-min-microvolt = <690000>;
		regulator-max-microvolt = <1050000>;
		regulator-always-on;
		vin-supply = <&dc_in>;
	};

	vddcpu_b: regulator-vddcpu-b {
		compatible = "pwm-regulator";
		pwms = <&pwm_AO_cd 1 1250 0>;
		regulator-name = "VDDCPU_B";
		regulator-min-microvolt = <690000>;
		regulator-max-microvolt = <1050000>;
		regulator-always-on;
		vin-supply = <&dc_in>;
	};

	host_vbus: regulator-host-vbus {
		compatible = "regulator-fixed";
		regulator-name = "host_vbus";
		regulator-always-on;
		regulator-boot-on;
		gpio = <&gpio GPIOH_5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	gpio_fan: gpio-fan {
		compatible = "gpio-fan";
		gpios = <&gpio_ao GPIOAO_11 GPIO_ACTIVE_HIGH>;
		gpio-fan,speed-map = <0 0 3000 1>;
		#cooling-cells = <2>;
	};

	adc_keys: adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 2>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1700000>;
		poll-interval = <100>;

		button-recovery {
			label = "Recovery";
			linux,code = <KEY_RESTART>;
			press-threshold-microvolt = <10000>;
		};
	};

	wifi32k: wifi32k {
		compatible = "pwm-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		pwms = <&pwm_ef 0 30518 0>;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&wifi32k>;
		clock-names = "ext_clock";
		reset-gpios = <&gpio GPIOX_7 GPIO_ACTIVE_LOW>;
	};

	speaker_amplifier: speaker-amplifier {
		compatible = "simple-audio-amplifier";
		sound-name-prefix = "Speaker Amplifier";
		VCC-supply = <&regulator-vdd-amp>;
		enable-gpios = <&gpio GPIOH_5 GPIO_ACTIVE_HIGH>;
	};

	regulator-vdd-amp {
		compatible = "regulator-fixed";
		regulator-name = "vdd_amp";
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&dc_in>;
	};
};

&sd_emmc_c {
	status = "okay";
	pinctrl-0 = <&emmc_ctrl_pins &emmc_data_8b_pins &emmc_ds_pins>;
	pinctrl-1 = <&emmc_clk_gate_pins>;
	pinctrl-names = "default", "clk-gate";
	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	max-frequency = <200000000>;
	non-removable;
	vmmc-supply = <&vsys_3v3>;
	vqmmc-supply = <&vddao_1v8>;
};

&sd_emmc_a {
	status = "okay";
	pinctrl-0 = <&sdio_pins>;
	pinctrl-1 = <&sdio_clk_gate_pins>;
	pinctrl-names = "default", "clk-gate";
	bus-width = <4>;
	cap-sd-highspeed;
	sd-uhs-ddr50;
	max-frequency = <200000000>;
	non-removable;
	keep-power-in-suspend;
	vmmc-supply = <&vsys_3v3>;
	vqmmc-supply = <&vddao_1v8>;
	mmc-pwrseq = <&sdio_pwrseq>;
};

&uart_AO {
	status = "okay";
	pinctrl-0 = <&uart_ao_a_pins>;
	pinctrl-names = "default";
};

&usb {
	status = "okay";
	dr_mode = "host";
};

&usb2_phy0 {
	status = "okay";
	phy-supply = <&vsys_3v3>;
};

&usb2_phy1 {
	status = "okay";
	phy-supply = <&host_vbus>;
};

ðmac {
	status = "okay";
	pinctrl-0 = <ð_pins &eth_rgmii_pins>;
	pinctrl-names = "default";
	phy-mode = "rgmii";
	phy-handle = <&external_phy>;
};

&ext_mdio {
	external_phy: ethernet-phy@0 {
		reg = <0>;
		max-speed = <1000>;
	};
};

&hdmi_tx {
	status = "okay";
	pinctrl-0 = <&hdmitx_hpd_pins &hdmitx_ddc_pins>;
	pinctrl-names = "default";
};

&vpu {
	status = "okay";
};

&fb {
	status = "okay";
};

&cec_AO {
	status = "okay";
	pinctrl-0 = <&cec_ao_a_h_pins>;
	pinctrl-names = "default";
};

&ir {
	status = "okay";
	pinctrl-0 = <&remote_input_ao_pins>;
	pinctrl-names = "default";
};

&pwm_ab {
	status = "okay";
	pinctrl-0 = <&pwm_a_e_pins>;
	pinctrl-names = "default";
};

&pwm_ef {
	status = "okay";
	pinctrl-0 = <&pwm_e_pins>;
	pinctrl-names = "default";
};

&pwm_AO_cd {
	status = "okay";
	pinctrl-0 = <&pwm_ao_d_e_pins>;
	pinctrl-names = "default";
};

&saradc {
	status = "okay";
	vref-supply = <&vddao_1v8>;
};

&watchdog {
	status = "okay";
};

&vrtc {
	status = "okay";
};

&sm {
	status = "okay";
};
