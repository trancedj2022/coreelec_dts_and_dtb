/dts-v1/;

#include "meson-g12b-a311d.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "CAINIAO XiaoYi Pro";
	compatible = "cainiao,xiaoyi-pro", "amlogic,a311d";

	chosen {
		bootargs = "root=LABEL=COREELEC rw console=ttyAML0,115200n8 console=tty0 no_console_suspend";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0xee6b2800>;
	};

	aliases {
		serial0 = &uart_AO;
	};

	/* 电源 */
	dc_in: regulator-dc-in {
		compatible = "regulator-fixed";
		regulator-name = "dc_in";
		regulator-always-on;
		regulator-boot-on;
	};

	vsys_3v3: regulator-vsys-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vsys_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&dc_in>;
	};

	vddao_1v8: regulator-vddao-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vddao_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&dc_in>;
	};

	host_vbus: regulator-host-vbus {
		compatible = "regulator-fixed";
		regulator-name = "host_vbus";
		regulator-always-on;
		regulator-boot-on;
		gpio = <&gpio GPIOH_5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vdd_amp: regulator-vdd-amp {
		compatible = "regulator-fixed";
		regulator-name = "vdd_amp";
		regulator-always-on;
		regulator-boot-on;
	};
};

/* ========== UART ========== */
&uart_AO {
	status = "okay";
};

/* ========== eMMC ========== */
&sd_emmc_c {
	status = "okay";
	bus-width = <8>;
	non-removable;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	max-frequency = <200000000>;
	vmmc-supply = <&vsys_3v3>;
	vqmmc-supply = <&vddao_1v8>;
};

/* ========== USB ========== */
&usb {
	status = "okay";
	dr_mode = "host";
};

&usb2_phy0 {
	status = "okay";
	phy-supply = <&vsys_3v3>;
};

&usb2_phy1 {
	status = "okay";
	phy-supply = <&host_vbus>;
};

/* ========== 以太网 ========== */
ðmac {
	status = "okay";
	phy-mode = "rgmii";
};

/* ========== HDMI ========== */
&hdmi_tx {
	status = "okay";
};

&vpu {
	status = "okay";
};

&fb {
	status = "okay";
};

/* ========== CEC ========== */
&cec_AO {
	status = "okay";
};

/* ========== IR ========== */
&ir {
	status = "okay";
};

/* ========== 看门狗 ========== */
&watchdog {
	status = "okay";
};

/* ========== RTC ========== */
&vrtc {
	status = "okay";
};
