name: Compile XiaoYi Pro DTS to DTB

on:
  workflow_dispatch:
  push:
    paths:
      - 'dts/*.dts'

permissions:
  contents: write

env:
  APT: sudo apt -y -qq -o=Dpkg::Use-Pty=0
  LINUX_AMLOGIC_GIT: https://github.com/CoreELEC/linux-amlogic.git
  LINUX_AMLOGIC_ROOT: /tmp/linux-amlogic
  OUTPUT_DIR: /tmp/output

jobs:
  compile:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout repository
      uses: actions/checkout@v4
      with:
        fetch-depth: 0

    - name: Install prerequisites
      run: |
        $APT update
        $APT install device-tree-compiler bc bison flex build-essential

    - name: Clone CoreELEC kernel
      run: |
        git clone -q --depth=1 "$LINUX_AMLOGIC_GIT" "$LINUX_AMLOGIC_ROOT"
        cd "$LINUX_AMLOGIC_ROOT"
        echo "=== Available DTS files in kernel ==="
        find arch/arm64/boot/dts/amlogic -name "*.dts" ! -name "*.dtsi" | head -20
        echo "=== Available DTSI files ==="
        find arch/arm64/boot/dts/amlogic -name "*.dtsi" | grep -E "a311d|s922x|g12b" | head -10

    - name: Create compatible DTS
      run: |
        cd "$LINUX_AMLOGIC_ROOT"
        
        # 查找实际存在的 A311D 或 S922X DTSI
        DTSI_FILE=""
        if [ -f "arch/arm64/boot/dts/amlogic/meson-g12b-s922x.dtsi" ]; then
          DTSI_FILE="meson-g12b-s922x.dtsi"
        elif [ -f "arch/arm64/boot/dts/amlogic/meson-g12b-a311d.dtsi" ]; then
          DTSI_FILE="meson-g12b-a311d.dtsi"
        else
          DTSI_FILE="meson-g12b.dtsi"
        fi
        
        echo "Using DTSI: $DTSI_FILE"
        echo "DTSI_FILE=$DTSI_FILE" >> $GITHUB_ENV
        
        # 生成 DTS 文件
        cat > arch/arm64/boot/dts/amlogic/meson-g12b-xiaoyi-pro.dts << 'EOF'
/dts-v1/;

EOF
        
        echo "#include \"$DTSI_FILE\"" >> arch/arm64/boot/dts/amlogic/meson-g12b-xiaoyi-pro.dts
        
        cat >> arch/arm64/boot/dts/amlogic/meson-g12b-xiaoyi-pro.dts << 'EOF'

/ {
	model = "CAINIAO XiaoYi Pro";
	compatible = "cainiao,xiaoyi-pro", "amlogic,a311d";

	chosen {
		bootargs = "root=LABEL=COREELEC rw console=ttyAML0,115200n8 console=tty0 no_console_suspend";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0xee6b2800>;
	};
};

&uart_AO {
	status = "okay";
};

&sd_emmc_c {
	status = "okay";
	bus-width = <8>;
	non-removable;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
};

&usb {
	status = "okay";
	dr_mode = "host";
};

&usb2_phy0 {
	status = "okay";
};

&usb2_phy1 {
	status = "okay";
};

ðmac {
	status = "okay";
	phy-mode = "rgmii";
};

&hdmi_tx {
	status = "okay";
};

&vpu {
	status = "okay";
};

&fb {
	status = "okay";
};

&cec_AO {
	status = "okay";
};

&ir {
	status = "okay";
};

&watchdog {
	status = "okay";
};

&vrtc {
	status = "okay";
};
EOF
        
        echo "=== Generated DTS ==="
        cat arch/arm64/boot/dts/amlogic/meson-g12b-xiaoyi-pro.dts

    - name: Compile DTS using kernel Makefile
      run: |
        cd "$LINUX_AMLOGIC_ROOT"
        
        # 显示生成的 DTS
        echo "=== DTS file to compile ==="
        ls -la arch/arm64/boot/dts/amlogic/meson-g12b-xiaoyi-pro.dts
        
        # 检查 Makefile 是否包含我们的文件
        if ! grep -q "meson-g12b-xiaoyi-pro" arch/arm64/boot/dts/amlogic/Makefile 2>/dev/null; then
          echo "Adding to Makefile..."
          echo "dtb-\$(CONFIG_ARCH_MESON) += meson-g12b-xiaoyi-pro.dtb" >> arch/arm64/boot/dts/amlogic/Makefile
        fi
        
        # 编译 DTBS
        echo "=== Compiling DTBS ==="
        make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- dtbs 2>&1 || echo "Make failed, trying manual..."
        
        # 如果 Make 失败，手动编译
        if [ ! -f "arch/arm64/boot/dts/amlogic/meson-g12b-xiaoyi-pro.dtb" ]; then
          echo "=== Manual compilation ==="
          mkdir -p "$OUTPUT_DIR"
          
          # 直接使用 dtc 编译
          dtc -I dts -O dtb \
            -o "$OUTPUT_DIR/meson-g12b-xiaoyi-pro.dtb" \
            arch/arm64/boot/dts/amlogic/meson-g12b-xiaoyi-pro.dts 2>&1 || \
          dtc -I dts -O dtb -q \
            -o "$OUTPUT_DIR/meson-g12b-xiaoyi-pro.dtb" \
            arch/arm64/boot/dts/amlogic/meson-g12b-xiaoyi-pro.dts || true
        else
          # 复制编译好的 DTB
          cp arch/arm64/boot/dts/amlogic/meson-g12b-xiaoyi-pro.dtb "$OUTPUT_DIR/"
        fi
        
        # 显示结果
        echo "=== Output directory ==="
        ls -la "$OUTPUT_DIR/" 2>/dev/null || echo "No files"

    - name: Decompile DTB (if exists)
      run: |
        if [ -f "$OUTPUT_DIR/meson-g12b-xiaoyi-pro.dtb" ]; then
          echo "=== Decompiling DTB ==="
          dtc -I dtb -O dts \
            -o "$OUTPUT_DIR/meson-g12b-xiaoyi-pro.decompiled.dts" \
            "$OUTPUT_DIR/meson-g12b-xiaoyi-pro.dtb" 2>/dev/null || true
          ls -la "$OUTPUT_DIR/"
        else
          echo "No DTB to decompile"
        fi

    - name: Create Release
      run: |
        mkdir -p /tmp/release
        
        # 复制所有生成的文件
        if [ -d "$OUTPUT_DIR" ]; then
          cp -r "$OUTPUT_DIR"/* /tmp/release/ 2>/dev/null || true
        fi
        
        # 也复制原始 DTS
        if [ -f "$LINUX_AMLOGIC_ROOT/arch/arm64/boot/dts/amlogic/meson-g12b-xiaoyi-pro.dts" ]; then
          cp "$LINUX_AMLOGIC_ROOT/arch/arm64/boot/dts/amlogic/meson-g12b-xiaoyi-pro.dts" /tmp/release/
        fi
        
        cd /tmp/release
        RELEASE_ZIP="/tmp/xiaoyi-pro-dtb.zip"
        zip -9 -j "$RELEASE_ZIP" * 2>/dev/null || true
        echo "RELEASE_ZIP=$RELEASE_ZIP" >> $GITHUB_ENV
        
        # 检查是否有文件
        if [ -z "$(ls -A /tmp/release 2>/dev/null)" ]; then
          echo "No files to release"
          exit 1
        fi
        
        echo "=== Release contents ==="
        ls -la /tmp/release/
        sha256sum --tag "$RELEASE_ZIP" | tee /tmp/releasenotes

    - name: Create GitHub Release
      uses: softprops/action-gh-release@v2
      with:
        make_latest: true
        tag_name: "v$(date '+%Y%m%d-%H%M%S')"
        generate_release_notes: true
        files: |
          ${{ env.RELEASE_ZIP }}
